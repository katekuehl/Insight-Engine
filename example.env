# Database Configuration
# REQUIRED: Connection string for the PostgreSQL database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/insight_engine"

# Application Configuration
# Port for the Express server (Frontend + Backend API)
PORT=5000

# Analytics Service Configuration
# Port for the Python FastAPI analytics service
ANALYTICS_PORT=8000

# Authentication (Supabase)
# REQUIRED for authentication to work on the frontend
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# Email Service (Resend)
# Optional: If not set, emails will be printed to console/skipped
RESEND_API_KEY="re_123456789"

# Payment Service (Stripe)
# Optional: Required only if billing features are enabled
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRO_PRICE_ID="price_..."
STRIPE_STARTER_PRICE_ID="price_..."
